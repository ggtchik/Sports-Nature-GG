{
  "name": "gg-sports-nature",
  "private": true,
  "version": "1.0.0",
  "description": "GG Sports-Nature — station de préparation et d'aide à la décision pour les activités de plein air et nautiques.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run.mjs",
    "test:unit": "npx esbuild --bundle --platform=node --format=cjs --outfile=node_modules/.cache/verify.cjs tests/verify.ts && node node_modules/.cache/verify.cjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
